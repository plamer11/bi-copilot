# 复制为 .env 后填入你的 Key（本文件是模板，不含任何真实密钥）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 国内镜像，加速 embedding 模型下载
HF_ENDPOINT=https://hf-mirror.com

# ---- Schema 检索的语义通道（默认关闭，纯关键词通道就能跑全链路）----
# 想体验语义召回再打开：false -> true
USE_EMBEDDING_RETRIEVAL=false
# auto=按 local -> api -> hash 顺序挑第一个可用的；想固定就写 local / api / hash
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 融合权重：最终分 = (1-w)*关键词分 + w*语义分
EMBEDDING_WEIGHT=0.5
